#!/bin/sh
# Leak guard on every commit about to be pushed (each one, not just the end result).
ROOT="$(git rev-parse --show-toplevel)"
PY="$ROOT/.venv/bin/python"; [ -x "$PY" ] || PY=python3
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                      # deleting a branch
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha --not --remotes"                         # new branch: commits not on GitHub yet
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  "$PY" "$ROOT/scripts/leak_guard.py" --commits $range || status=1
done
exit $status
